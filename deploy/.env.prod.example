# Fichier d'exemple pour le serveur AWS (rempli à l'étape de déploiement)
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-3
BACKEND_IMAGE=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/flotte-backend:1.0.0
FRONTEND_IMAGE=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/flotte-frontend:1.0.0

POSTGRES_DB=flotte
POSTGRES_USER=flotte
POSTGRES_PASSWORD=__sera_recupere_depuis_SSM_Parameter_Store__
SEED_DEMO_DATA=true
