# Copier ce fichier :  cp .env.example .env   puis adapter les valeurs.
# Le fichier .env n'est JAMAIS versionné dans Git (il contient des secrets).

POSTGRES_DB=flotte
POSTGRES_USER=flotte
POSTGRES_PASSWORD=change-moi-Local-2026

# Port sur lequel l'appli est accessible : http://localhost:8080
HTTP_PORT=8080

# Crée les 5 utilisateurs et les véhicules de démo si la base est vide
SEED_DEMO_DATA=true
